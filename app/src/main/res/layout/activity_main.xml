<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout principal del launcher. Estructura por capas (FrameLayout):
        1. MapView de VTM (OpenGL ES 2.0) ocupando todo el fondo.
        2. Overlay con texto de estado (esquina superior izquierda).
        3. Botón "Recentrar" (esquina inferior izquierda, oculto hasta pan manual).
        4. Botón de emergencia hacia Ajustes (esquina inferior derecha, siempre visible).
    El orden de los hijos en XML es importante: el último se dibuja por encima.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- VTM MapView: renderizado vectorial sobre GLES 2.0 (compatible Mali-450).
         Lee los mismos archivos .map de OSM que usaba Mapsforge. -->
    <org.oscim.android.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Flecha del coche en modo centrado: una View fija sobre el mapa.
         MainActivity la coloca al 75% de la altura, que es donde cae el coche. -->
    <ImageView
        android:id="@+id/carArrowOverlay"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@string/car_arrow_desc"
        android:src="@drawable/ic_position_arrow"
        android:visibility="gone" />

    <!-- Columna superior: HUD de maniobra y, debajo, la vía actual. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical">

    <!--
        Panel de navegación superior (HUD de maniobra).
        Solo visible cuando hay ruta activa y próxima maniobra.
        Diseñado para ser legible a distancia en el coche (fuente grande, iconos grandes).
    -->
    <LinearLayout
        android:id="@+id/navManeuverPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC101418"
        android:gravity="center_vertical"
        android:minHeight="80dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Icono de la maniobra -->
        <ImageView
            android:id="@+id/navManeuverIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/nav_maneuver_icon_desc"
            android:src="@drawable/ic_maneuver_straight"
            android:tint="#FFFFFFFF" />

        <!-- Distancia + nombre de calle en columna vertical -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navManeuverDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navManeuverStreet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFB0B0B0"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

        <!-- Referencia de la vía actual (autovía, nacional o primaria). -->
        <TextView
            android:id="@+id/roadNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#CC101418"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!--
        Columna de overlays superior izquierda: primero el HUD de consumo y
        luego el texto de estado del GPS/mapa. El LinearLayout vertical los
        apila sin que se solapen.
        El layout_margin es el mismo 16dp que tenía el statusText para mantener
        el margen visual original.
    -->
    <LinearLayout
        android:id="@+id/topStartOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <!--
            Contenedor del HUD de consumo. Empieza GONE si no hay MAC
            configurada; MainActivity lo hace VISIBLE al hacer bind al servicio.
            El fondo semitransparente va aquí para que el IndicatorView no
            necesite pintarlo él mismo (la View no pinta fondo propio).
        -->
        <FrameLayout
            android:id="@+id/hudContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="#CC101418"
            android:padding="8dp"
            android:visibility="gone">

            <obdmap.launcher.ui.IndicatorView
                android:id="@+id/hudFuelIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:label="@string/hud_fuel_label"
                app:unit="@string/hud_fuel_unit_l100km" />

        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#80000000"
            android:padding="10dp"
            android:text="@string/status_initializing"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="220dp"
        android:background="#B0000000"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="#FF00E676"
        android:textSize="25sp"
        android:visibility="gone" />

    <!-- Overlay de diagnóstico de rendimiento (FPS, GC, heap). -->
    <TextView
        android:id="@+id/perfOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:layout_marginTop="96dp"
        android:background="#B0000000"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="#FF00E676"
        android:textSize="14sp"
        android:visibility="gone" />

    <!--
        Badge circular de velocidad GPS (esquina inferior izquierda, siempre visible).
        El recenterButton, al estar declarado después, se dibuja encima cuando es VISIBLE.
    -->
    <obdmap.launcher.ui.SpeedBadgeView
        android:id="@+id/speedBadge"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp" />

    <Button
        android:id="@+id/recenterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/btn_hud_primary"
        android:minHeight="72dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/recenter_button"
        android:textColor="@color/on_accent"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Corazón sobre el badge de velocidad: abre el desplegable de sitios guardados. -->
    <ImageButton
        android:id="@+id/favoritesButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="114dp"
        android:background="@drawable/btn_hud_night"
        android:contentDescription="@string/favorites_button_desc"
        android:src="@drawable/ic_heart_filled"
        android:tint="@color/accent" />

    <!-- Desplegable de sitios guardados; la lista se rellena en runtime al abrirlo. -->
    <LinearLayout
        android:id="@+id/favoritesPanel"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="194dp"
        android:background="#CC101418"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <LinearLayout
                android:id="@+id/favoritesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

    <!-- Capa transparente que cierra el panel de destino al tocar fuera de él. -->
    <View
        android:id="@+id/destConfirmScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Panel de confirmación de destino por long-press. -->
    <LinearLayout
        android:id="@+id/destConfirmPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="#CC101418"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/destConfirmText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="12dp"
            android:text="@string/dest_confirm_no_gps"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <!-- Toggle de guardado del punto elegido; no cierra el panel. -->
            <ImageButton
                android:id="@+id/destFavoriteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_hud_night"
                android:contentDescription="@string/dest_favorite_desc"
                android:minHeight="72dp"
                android:minWidth="72dp"
                android:src="@drawable/ic_heart_outline"
                android:tint="@color/accent" />

            <Button
                android:id="@+id/destConfirmGoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/btn_hud_primary"
                android:minHeight="72dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/dest_confirm_go"
                android:textColor="@color/on_accent"
                android:textSize="18sp" />

            <Button
                android:id="@+id/destConfirmCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_hud_night"
                android:minHeight="72dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/dest_confirm_cancel"
                android:textColor="@color/accent"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <!--
        Barra inferior de resumen de navegación: distancia restante + ETA.
        Solo visible cuando hay ruta activa.
        Se coloca centrada en la parte inferior, por encima del botón Destino.
    -->
    <LinearLayout
        android:id="@+id/navSummaryBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="#CC101418"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/navRemainingDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="#FFB0B0B0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/navEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Fila inferior derecha: "Cancelar ruta" (solo con ruta activa) y "Ajustes". -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancelRouteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/btn_hud_night"
            android:minHeight="72dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/cancel_route_button"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/appSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_hud_night"
            android:minHeight="72dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/app_settings_button"
            android:textColor="@color/accent"
            android:textSize="18sp" />

    </LinearLayout>

</FrameLayout>
