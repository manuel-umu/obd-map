<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de Ajustes: menú de nivel superior. Solo botones de navegación.
    El detalle (Bluetooth OBD, debug, info) vive en sus propias pantallas.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="150dp"
            android:paddingBottom="16dp">

            <!-- Fila 1 de la rejilla de opciones. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hud_night"
                    android:minHeight="110dp"
                    android:text="@string/settings_open_bluetooth"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnSystemSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hud_night"
                    android:minHeight="110dp"
                    android:text="@string/settings_open_system"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

            </LinearLayout>

            <!-- Fila 2 de la rejilla de opciones. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnObdDebug"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hud_night"
                    android:minHeight="110dp"
                    android:text="@string/settings_open_obd_debug"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

                <!-- Toggle del overlay de diagnóstico de snap del mapa. -->
                <Button
                    android:id="@+id/btnToggleDebugOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hud_night"
                    android:minHeight="110dp"
                    android:text="@string/settings_debug_overlay_off"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

            </LinearLayout>

            <!-- Fila 3: ocupa el ancho completo de la rejilla. -->
            <Button
                android:id="@+id/btnInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_hud_night"
                android:minHeight="110dp"
                android:text="@string/settings_open_info"
                android:textColor="@color/accent"
                android:textSize="20sp" />

            <!-- Fila 4: overlay de rendimiento (solo fps) y su informe completo. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTogglePerfOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hud_night"
                    android:minHeight="110dp"
                    android:text="@string/settings_perf_overlay_off"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnTogglePerfFull"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_hud_night"
                    android:minHeight="110dp"
                    android:text="@string/settings_perf_full_off"
                    android:textColor="@color/accent"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/btn_hud_night"
        android:minHeight="110dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/back_button"
        android:textColor="@color/accent"
        android:textSize="18sp" />

    <!-- Toggle día/noche flotante, simétrico a btnBack. -->
    <Button
        android:id="@+id/btnDayNight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_hud_night"
        android:minHeight="110dp"
        android:minWidth="160dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/day_night_auto"
        android:textColor="@color/accent"
        android:textSize="18sp" />

</FrameLayout>
